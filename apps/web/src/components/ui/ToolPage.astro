---
/**
 * Halaman tool lengkap dari konten SEO (src/content/tools/<bahasa>/<slug>.md):
 * judul, badge privasi, area tool (slot), cara pakai, isi Markdown, FAQ, tools terkait,
 * serta structured data SoftwareApplication, HowTo, dan FAQPage.
 */
import { getCollection, getEntry, render } from 'astro:content';
import { getLocale } from '../../i18n';
import { toolPath } from '../../lib/categories';
import { SITE } from '../../lib/site';
import ToolLayout from './ToolLayout.astro';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const locale = getLocale(Astro.url);
const entry = await getEntry('tools', `${locale}/${slug}`);
if (!entry) throw new Error(`Konten tool tidak ditemukan: src/content/tools/${locale}/${slug}.md`);

const { data } = entry;
const { Content } = await render(entry);
const related = (
  await Promise.all(data.related.map((r) => getEntry('tools', `${locale}/${r}`)))
).filter((e) => e !== undefined);

const url = new URL(toolPath(locale, slug), SITE.url).href;

// Pasangan halaman di bahasa lain (slug berbeda per bahasa, dihubungkan lewat idSlug).
const alternates: Partial<Record<'id' | 'en', string>> = { [locale]: toolPath(locale, slug) };
if (locale === 'id') {
  const en = (await getCollection('tools', (e) => e.id.startsWith('en/'))).find(
    (e) => e.data.idSlug === slug,
  );
  if (en) alternates.en = toolPath('en', en.id.split('/')[1]);
} else if (data.idSlug) {
  alternates.id = toolPath('id', data.idSlug);
}
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: data.title,
    description: data.description,
    url,
    applicationCategory:
      data.category === 'developer' ? 'DeveloperApplication' : 'UtilitiesApplication',
    operatingSystem: 'Web',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'IDR' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: data.title,
    step: data.howTo.map((text, i) => ({ '@type': 'HowToStep', position: i + 1, text })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: data.faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];
// Cegah "</script>" di dalam JSON menutup tag lebih awal.
const jsonLdText = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---

<ToolLayout
  title={data.title}
  description={data.description}
  processing={data.processing}
  category={data.category}
  alternates={alternates}
>
  <script slot="head" type="application/ld+json" is:inline set:html={jsonLdText} />
  <slot />

  <ol slot="how-to" class="grid border-t border-ink sm:grid-cols-3">
    {data.howTo.map((step, i) => (
      <li class="flex gap-4 border-b border-rule py-5 sm:border-b-0 sm:py-6 sm:pr-6 sm:not-first:border-l sm:not-first:pl-6">
        <span
          class="font-display text-5xl leading-none text-brand-600 dark:text-brand-400"
          aria-hidden="true"
        >
          {i + 1}
        </span>
        <span class="pt-1 leading-relaxed text-ink-2">{step}</span>
      </li>
    ))}
  </ol>

  <Fragment slot="about">
    <Content />
  </Fragment>

  <div slot="faq" class="border-t border-ink">
    {data.faq.map(({ q, a }) => (
      <details class="group border-b border-rule">
        <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-4 text-lg font-semibold [&::-webkit-details-marker]:hidden">
          <span>{q}</span>
          <span
            class="mt-0.5 font-display text-2xl leading-none text-brand-600 transition-transform group-open:rotate-45 dark:text-brand-400"
            aria-hidden="true"
          >
            +
          </span>
        </summary>
        <p class="max-w-2xl pb-5 leading-relaxed text-ink-2">{a}</p>
      </details>
    ))}
  </div>

  {related.length > 0 && (
    <ul slot="related" class="grid gap-x-10 border-t border-ink sm:grid-cols-2">
      {related.map((r) => (
        <li data-cat={r.data.category}>
          <a
            href={toolPath(locale, r.id.split('/')[1])}
            class="group flex items-baseline justify-between gap-4 border-b border-rule py-4"
          >
            <span>
              <span class="font-semibold group-hover:text-brand-700 dark:group-hover:text-brand-300">
                {r.data.name}
              </span>
              <span class="mt-0.5 block text-sm text-ink-3">{r.data.summary}</span>
            </span>
            <span
              class="text-brand-600 transition-transform group-hover:translate-x-1 dark:text-brand-400"
              aria-hidden="true"
            >
              →
            </span>
          </a>
        </li>
      ))}
    </ul>
  )}
</ToolLayout>
