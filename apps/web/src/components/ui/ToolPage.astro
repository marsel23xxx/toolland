---
/**
 * Halaman tool lengkap dari konten SEO (src/content/tools/<bahasa>/<slug>.md):
 * judul, badge privasi, area tool (slot), cara pakai, isi Markdown, FAQ, tools terkait,
 * serta structured data SoftwareApplication, HowTo, dan FAQPage.
 */
import { getCollection, getEntry, render } from 'astro:content';
import { getLocale } from '../../i18n';
import { toolPath } from '../../lib/categories';
import { SITE } from '../../lib/site';
import ToolLayout from './ToolLayout.astro';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const locale = getLocale(Astro.url);
const entry = await getEntry('tools', `${locale}/${slug}`);
if (!entry) throw new Error(`Konten tool tidak ditemukan: src/content/tools/${locale}/${slug}.md`);

const { data } = entry;
const { Content } = await render(entry);
const related = (
  await Promise.all(data.related.map((r) => getEntry('tools', `${locale}/${r}`)))
).filter((e) => e !== undefined);

const url = new URL(toolPath(locale, slug), SITE.url).href;

// Pasangan halaman di bahasa lain (slug berbeda per bahasa, dihubungkan lewat idSlug).
const alternates: Partial<Record<'id' | 'en', string>> = { [locale]: toolPath(locale, slug) };
if (locale === 'id') {
  const en = (await getCollection('tools', (e) => e.id.startsWith('en/'))).find(
    (e) => e.data.idSlug === slug,
  );
  if (en) alternates.en = toolPath('en', en.id.split('/')[1]);
} else if (data.idSlug) {
  alternates.id = toolPath('id', data.idSlug);
}
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: data.title,
    description: data.description,
    url,
    applicationCategory:
      data.category === 'developer' ? 'DeveloperApplication' : 'UtilitiesApplication',
    operatingSystem: 'Web',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'IDR' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: data.title,
    step: data.howTo.map((text, i) => ({ '@type': 'HowToStep', position: i + 1, text })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: data.faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];
// Cegah "</script>" di dalam JSON menutup tag lebih awal.
const jsonLdText = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---

<ToolLayout
  title={data.title}
  description={data.description}
  processing={data.processing}
  alternates={alternates}
>
  <script slot="head" type="application/ld+json" is:inline set:html={jsonLdText} />
  <slot />

  <ol slot="how-to" class="grid gap-3 sm:grid-cols-3">
    {data.howTo.map((step, i) => (
      <li class="card flex gap-3">
        <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-brand-600 text-sm font-bold text-white">
          {i + 1}
        </span>
        <span>{step}</span>
      </li>
    ))}
  </ol>

  <Fragment slot="about">
    <Content />
  </Fragment>

  <div
    slot="faq"
    class="divide-y divide-slate-200 rounded-xl border border-slate-200 dark:divide-slate-800 dark:border-slate-800"
  >
    {data.faq.map(({ q, a }) => (
      <details class="group px-4 py-3">
        <summary class="cursor-pointer font-semibold marker:text-brand-600">{q}</summary>
        <p class="mt-2 text-slate-600 dark:text-slate-400">{a}</p>
      </details>
    ))}
  </div>

  {related.length > 0 && (
    <ul slot="related" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {related.map((r) => (
        <li>
          <a
            href={toolPath(locale, r.id.split('/')[1])}
            class="card block h-full hover:border-brand-500"
          >
            <span class="font-semibold">{r.data.name}</span>
            <span class="mt-1 block text-sm text-slate-600 dark:text-slate-400">
              {r.data.summary}
            </span>
          </a>
        </li>
      ))}
    </ul>
  )}
</ToolLayout>
