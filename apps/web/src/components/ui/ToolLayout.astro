---
/**
 * Kerangka setiap halaman tool: breadcrumb, judul, badge privasi, area tool (island Vue),
 * lalu konten SEO statis (cara pakai, isi, FAQ, tools terkait) tanpa JavaScript.
 * Warna aksen mengikuti kategori (data-cat di body).
 */
import IconCpu from '~icons/lucide/cpu';
import IconServer from '~icons/lucide/server';
import { getLocale, useTranslations, type Locale } from '../../i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CATEGORY_NAMES, type CategoryId } from '../../lib/categories';

interface Props {
  /** Judul halaman (unik per tool), juga jadi <h1>. */
  title: string;
  /** Meta description, juga ditampilkan di bawah judul. */
  description: string;
  /** Tempat file diproses; menentukan badge privasi. */
  processing: 'browser' | 'server';
  category: CategoryId;
  alternates?: Partial<Record<Locale, string>>;
  noindex?: boolean;
}

const { title, description, processing, category, alternates, noindex } = Astro.props;
const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const onDevice = processing === 'browser';
const home = locale === 'en' ? '/en' : '/';
---

<BaseLayout
  title={`${title} | Toolland`}
  description={description}
  alternates={alternates}
  noindex={noindex}
  cat={category}
>
  <slot name="head" slot="head" />

  <header class="mb-8">
    <nav aria-label="Breadcrumb" class="eyebrow">
      <a href={home} class="hover:text-ink">
        Toolland
      </a>
      <span aria-hidden="true"> / </span>
      <a href={`${home}#${category}`} class="text-brand-700 hover:underline dark:text-brand-300">
        {CATEGORY_NAMES[category][locale]}
      </a>
    </nav>
    <h1 class="mt-3 max-w-3xl font-display text-4xl leading-[1.05] tracking-tight sm:text-5xl">
      {title}
    </h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-2">{description}</p>
    <p class="mt-4 inline-flex items-center gap-2 text-sm font-medium text-ink-2">
      {onDevice ? (
        <IconCpu class="text-brand-600 dark:text-brand-400" aria-hidden="true" />
      ) : (
        <IconServer class="text-brand-600 dark:text-brand-400" aria-hidden="true" />
      )}
      {onDevice ? t('privacy.browser') : t('privacy.server')}
    </p>
  </header>

  <!-- Area tool: "meja kerja", harus terlihat tanpa scroll di HP. -->
  <section aria-label={title} class="rounded-md border border-ink bg-paper-2 p-4 sm:p-6">
    <slot />
  </section>

  {Astro.slots.has('how-to') && (
    <section class="mt-16">
      <h2 class="font-display text-3xl">{t('tool.howTo')}</h2>
      <div class="mt-6">
        <slot name="how-to" />
      </div>
    </section>
  )}

  {Astro.slots.has('about') && (
    <div class="prose-tool mt-12">
      <slot name="about" />
    </div>
  )}

  {Astro.slots.has('faq') && (
    <section class="mt-14">
      <h2 class="font-display text-3xl">{t('tool.faq')}</h2>
      <div class="mt-5">
        <slot name="faq" />
      </div>
    </section>
  )}

  {Astro.slots.has('related') && (
    <nav class="mt-14" aria-labelledby="related-heading">
      <h2 id="related-heading" class="font-display text-3xl">
        {t('tool.related')}
      </h2>
      <div class="mt-5">
        <slot name="related" />
      </div>
    </nav>
  )}
</BaseLayout>
