---
import type { ImageMetadata } from 'astro';
import { getCollection } from 'astro:content';
import IconSearch from '~icons/lucide/search';
import { useTranslations, type Locale } from '../../i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroDemo from './HeroDemo.astro';
import {
  CATEGORY_IDS,
  CATEGORY_NAMES,
  CATEGORY_NOTES,
  GROUP_NAMES,
  toolPath,
} from '../../lib/categories';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const tools = (await getCollection('tools', (e) => e.id.startsWith(`${locale}/`))).sort((a, b) =>
  a.data.name.localeCompare(b.data.name, locale),
);
const slugOf = (tool: (typeof tools)[number]) => tool.id.split('/')[1];

// Screenshot tool populer (dibuat scripts/shots.mjs): <bahasa>/<slug ID>-<light|dark>.webp
const SHOTS = import.meta.glob<ImageMetadata>('../../assets/shots/*/*.webp', {
  eager: true,
  import: 'default',
});
const shot = (tool: (typeof tools)[number], theme: 'light' | 'dark') =>
  SHOTS[`../../assets/shots/${locale}/${tool.data.idSlug ?? slugOf(tool)}-${theme}.webp`];
const popular = tools.filter((tool) => tool.data.popular && shot(tool, 'light'));
// Urutan populer tetap: gambar dulu, lalu PDF (sesuai urutan kategori).
popular.sort(
  (a, b) => CATEGORY_IDS.indexOf(a.data.category) - CATEGORY_IDS.indexOf(b.data.category),
);

const groups = CATEGORY_IDS.map((id) => {
  const inCat = tools.filter((tool) => tool.data.category === id);
  return {
    id,
    name: CATEGORY_NAMES[id][locale],
    note: CATEGORY_NOTES[id][locale],
    count: inCat.length,
    // Tool populer di atas, sisanya alfabetis; konverter dikumpulkan dalam satu baris.
    rows: [
      ...inCat.filter((x) => x.data.popular),
      ...inCat.filter((x) => !x.data.popular && !x.data.group),
    ],
    convert: inCat.filter((x) => x.data.group === 'konversi'),
  };
});

// Teks pencarian: nama, judul, ringkasan, dan kata kunci, huruf kecil tanpa aksen.
const searchText = (tool: (typeof tools)[number]) =>
  [tool.data.name, tool.data.title, tool.data.summary, ...tool.data.keywords]
    .join(' ')
    .normalize('NFD')
    .replace(/\p{M}/gu, '')
    .toLowerCase();
const pad = (n: number) => String(n).padStart(2, '0');
---

<BaseLayout
  title={`${t('site.name')}: ${t('site.tagline')}`}
  description={t('site.description')}
  alternates={{ id: '/', en: '/en' }}
  wide
>
  <section class="grid gap-10 border-b border-ink pb-12 lg:grid-cols-[1.35fr_1fr] lg:items-start">
    <div>
      <p class="eyebrow">{t('home.kicker', { n: tools.length })}</p>
      <h1 class="mt-4 font-display text-[2.6rem] leading-[1.02] tracking-tight sm:text-6xl lg:text-[4.5rem]">
        {t('home.headlineA')}{' '}
        <em class="font-normal text-terakota italic">{t('home.headlineEm')}</em>
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-2">{t('home.lead')}</p>
    </div>
    <div class="space-y-4">
      <div class="hidden pb-2 lg:block">
        <HeroDemo locale={locale} />
      </div>
      <div class="relative">
        <label for="tool-search" class="sr-only">
          {t('home.searchLabel')}
        </label>
        <IconSearch
          class="pointer-events-none absolute top-1/2 left-3.5 size-5 -translate-y-1/2 text-ink-3"
          aria-hidden="true"
        />
        <input
          id="tool-search"
          type="search"
          class="field h-12 pl-11 text-lg"
          placeholder={t('home.search')}
          autocomplete="off"
        />
      </div>
      <ul class="flex flex-wrap gap-x-5 gap-y-1 text-sm text-ink-2">
        <li class="flex items-center gap-2">
          <span class="size-2 bg-terakota" aria-hidden="true"></span>
          {t('home.fact1')}
        </li>
        <li class="flex items-center gap-2">
          <span class="size-2 bg-nila" aria-hidden="true"></span>
          {t('home.fact2')}
        </li>
        <li class="flex items-center gap-2">
          <span class="size-2 bg-daun" aria-hidden="true"></span>
          {t('home.fact3')}
        </li>
      </ul>
    </div>
  </section>

  <p id="no-results" class="py-10 text-ink-2" hidden>
    {t('home.noResults')}
  </p>

  <section id="popular-section" aria-labelledby="popular-title" class="py-12">
    <div class="flex items-end justify-between gap-4">
      <h2 id="popular-title" class="font-display text-3xl">
        {t('home.popular')}
      </h2>
      <button
        id="marquee-toggle"
        type="button"
        class="btn btn-secondary motion-reduce:hidden"
        aria-controls="popular-marquee"
        aria-pressed="false"
        data-pause={t('home.pause')}
        data-play={t('home.play')}
      >
        {t('home.pause')}
      </button>
    </div>
    <div id="popular-marquee" class="marquee mt-6" data-marquee>
      <div class="marquee-track">
        {[0, 1].map((copy) => (
          <ul class="marquee-list" aria-hidden={copy ? 'true' : undefined} inert={copy === 1}>
            {popular.map((tool) => {
              const light = shot(tool, 'light')!;
              const dark = shot(tool, 'dark') ?? light;
              return (
                <li data-cat={tool.data.category} class="w-64 shrink-0 sm:w-80">
                  <a href={toolPath(locale, slugOf(tool))} class="group block">
                    <picture>
                      <source srcset={dark.src} media="(prefers-color-scheme: dark)" />
                      <img
                        src={light.src}
                        width={light.width}
                        height={light.height}
                        alt=""
                        loading="lazy"
                        decoding="async"
                        class="aspect-[4/3] w-full rounded-md border border-rule bg-paper-2 object-contain object-top transition-transform duration-300 group-hover:-translate-y-1"
                      />
                    </picture>
                    <span class="eyebrow mt-3 block text-brand-700 dark:text-brand-300">
                      {CATEGORY_NAMES[tool.data.category][locale]}
                    </span>
                    <span class="mt-1 flex items-baseline justify-between gap-3">
                      <span class="font-display text-xl leading-tight group-hover:text-brand-700 dark:group-hover:text-brand-300">
                        {tool.data.name}
                      </span>
                      <span
                        class="text-brand-600 transition-transform group-hover:translate-x-1 dark:text-brand-400"
                        aria-hidden="true"
                      >
                        →
                      </span>
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        ))}
      </div>
    </div>
  </section>

  <section aria-labelledby="all-title" class="pt-12">
    <h2 id="all-title" class="sr-only">
      {t('home.all')}
    </h2>
    {groups.map((group, i) => (
      <section
        id={group.id}
        data-category
        data-cat={group.id}
        class="grid scroll-mt-6 gap-6 border-t border-ink py-8 lg:grid-cols-[15rem_1fr]"
      >
        <header>
          <p class="eyebrow">{pad(i + 1)}</p>
          <h3 class="mt-1 font-display text-3xl text-brand-700 dark:text-brand-300">
            {group.name}
          </h3>
          <p class="mt-1 text-sm text-ink-3">
            {group.note} · {t('home.count', { n: group.count })}
          </p>
        </header>
        <div>
          {group.count === 0 && <p class="text-ink-3">{t('home.comingSoon')}</p>}
          <ul class="grid gap-x-10 sm:grid-cols-2">
            {group.rows.map((tool) => (
              <li data-search={searchText(tool)}>
                <a
                  href={toolPath(locale, slugOf(tool))}
                  class="group flex items-baseline justify-between gap-4 border-b border-rule py-3.5"
                >
                  <span>
                    <span class="font-semibold group-hover:text-brand-700 dark:group-hover:text-brand-300">
                      {tool.data.name}
                    </span>
                    <span class="mt-0.5 block text-sm text-ink-3">{tool.data.summary}</span>
                  </span>
                  <span
                    class="text-brand-600 transition-transform group-hover:translate-x-1 dark:text-brand-400"
                    aria-hidden="true"
                  >
                    →
                  </span>
                </a>
              </li>
            ))}
          </ul>
          {group.convert.length > 0 && (
            <div data-group class="mt-6">
              <p class="eyebrow mb-3">{GROUP_NAMES.konversi[locale]}</p>
              <ul class="flex flex-wrap gap-2">
                {group.convert.map((tool) => (
                  <li data-search={searchText(tool)}>
                    <a
                      href={toolPath(locale, slugOf(tool))}
                      class="inline-block rounded-full border border-rule px-3.5 py-1.5 text-sm font-medium hover:border-brand-600 hover:text-brand-700 dark:hover:border-brand-400 dark:hover:text-brand-300"
                    >
                      {tool.data.name}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </section>
    ))}
  </section>
</BaseLayout>

<script>
  // Tombol jeda etalase berjalan (gerakan otomatis harus bisa dihentikan pengguna).
  const marquee = document.querySelector<HTMLElement>('[data-marquee]')!;
  const toggle = document.getElementById('marquee-toggle') as HTMLButtonElement;
  toggle.addEventListener('click', () => {
    const paused = !marquee.hasAttribute('data-paused');
    marquee.toggleAttribute('data-paused', paused);
    toggle.setAttribute('aria-pressed', String(paused));
    toggle.textContent = (paused ? toggle.dataset.play : toggle.dataset.pause) ?? '';
  });
</script>

<script>
  // Pencarian tools tanpa server: menyaring baris yang sudah ada di HTML.
  const input = document.getElementById('tool-search') as HTMLInputElement;
  const empty = document.getElementById('no-results')!;
  const popular = document.getElementById('popular-section')!;
  const sections = [...document.querySelectorAll<HTMLElement>('[data-category]')];

  input.addEventListener('input', () => {
    const terms = input.value
      .normalize('NFD')
      .replace(/\p{M}/gu, '')
      .toLowerCase()
      .split(/\s+/)
      .filter(Boolean);
    const searching = terms.length > 0;
    popular.hidden = searching;
    let visible = 0;
    for (const section of sections) {
      let shown = 0;
      for (const item of section.querySelectorAll<HTMLElement>('[data-search]')) {
        const match = terms.every((term) => item.dataset.search!.includes(term));
        item.hidden = !match;
        if (match) shown++;
      }
      for (const group of section.querySelectorAll<HTMLElement>('[data-group]')) {
        group.hidden = ![...group.querySelectorAll<HTMLElement>('[data-search]')].some(
          (x) => !x.hidden,
        );
      }
      section.hidden = searching && shown === 0;
      visible += shown;
    }
    empty.hidden = !searching || visible > 0;
  });
</script>
