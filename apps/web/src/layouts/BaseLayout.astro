---
import displayFontUrl from '@fontsource/fraunces/files/fraunces-latin-600-normal.woff2?url';
import fontUrl from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';
import { getCollection } from 'astro:content';
import IconChevronDown from '~icons/lucide/chevron-down';
import IconMenu from '~icons/lucide/menu';
import IconX from '~icons/lucide/x';
import NavTile from '../components/ui/NavTile.astro';
import ToolIcon from '../components/ui/ToolIcon.astro';
import { getLocale, pagePath, useTranslations, type Locale } from '../i18n';
import {
  CATEGORY_IDS,
  CATEGORY_NAMES,
  CATEGORY_NOTES,
  type CategoryId,
  toolPath,
} from '../lib/categories';
import { LOCALE_TAGS } from '../lib/format';
import { SITE } from '../lib/site';
import {
  TEMPLATE_CATEGORY_IDS,
  TEMPLATE_CATEGORY_NAMES,
  TEMPLATE_CATEGORY_NOTES,
  type TemplateCategoryId,
  UPCOMING_TEMPLATES,
  templatePath,
  templatesHome,
} from '../lib/templates/catalog';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Path halaman yang sama di tiap bahasa, untuk hreflang dan tombol ganti bahasa. */
  alternates?: Partial<Record<Locale, string>>;
  noindex?: boolean;
  /** Kategori halaman: menentukan warna aksen (terakota, nila, kunyit, daun, secang). */
  cat?: CategoryId | TemplateCategoryId;
  /** Lebar konten: lebar untuk beranda, sedang untuk halaman tool dan teks. */
  wide?: boolean;
}

const { title, description, alternates = {}, noindex = false, cat, wide = false } = Astro.props;
const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const canonical = new URL(pagePath(Astro.url), SITE.url).href;
const otherLocale: Locale = locale === 'id' ? 'en' : 'id';
const switchHref = alternates[otherLocale] ?? (otherLocale === 'en' ? '/en' : '/');
const homeHref = locale === 'en' ? '/en' : '/';
const width = wide ? 'max-w-6xl' : 'max-w-5xl';
const donateHref = locale === 'en' ? '/en/support' : '/dukung';
const privacyHref = locale === 'en' ? '/en/privacy' : '/kebijakan-privasi';
const tplHome = templatesHome(locale);

// Isi dropdown navbar: satu menu per kategori tools (populer dulu, lalu alfabetis), plus Template.
const allTools = await getCollection('tools', (e) => e.id.startsWith(`${locale}/`));
const toolMenus = CATEGORY_IDS.map((id) => {
  const items = allTools
    .filter((x) => x.data.category === id)
    .sort(
      (a, b) =>
        Number(b.data.popular) - Number(a.data.popular) ||
        a.data.name.localeCompare(b.data.name, locale),
    )
    .map((x) => {
      const slug = x.id.split('/')[1];
      return {
        name: x.data.name,
        note: x.data.summary,
        href: toolPath(locale, slug),
        icon: x.data.idSlug ?? slug,
      };
    });
  return {
    id,
    name: CATEGORY_NAMES[id][locale],
    note: CATEGORY_NOTES[id][locale],
    href: `${homeHref}#${id}`,
    items,
    // Lebar panel mengikuti jumlah item.
    panel: items.length > 10 ? 'w-[54rem]' : items.length > 4 ? 'w-[38rem]' : 'w-80',
    grid: items.length > 10 ? 'grid-cols-3' : items.length > 4 ? 'grid-cols-2' : '',
  };
});
const templates = await getCollection('templates', (e) => e.id.startsWith(`${locale}/`));
const tplItems = TEMPLATE_CATEGORY_IDS.flatMap((id) => [
  ...templates
    .filter((x) => x.data.category === id)
    .map((x) => ({
      cat: id,
      name: x.data.name,
      note: x.data.summary,
      href: templatePath(locale, x.id.split('/')[1]) as string | undefined,
    })),
  ...UPCOMING_TEMPLATES.filter((x) => x.category === id).map((x) => ({
    cat: id,
    name: x.name[locale],
    note: TEMPLATE_CATEGORY_NOTES[id][locale],
    href: undefined,
  })),
]);
const tplCats = TEMPLATE_CATEGORY_IDS.map((id) => ({
  id,
  name: TEMPLATE_CATEGORY_NAMES[id][locale],
}));
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {Object.entries(alternates).map(([lang, path]) => (
      <link
        rel="alternate"
        hreflang={LOCALE_TAGS[lang as Locale]}
        href={new URL(path, SITE.url).href}
      />
    ))}
    {alternates.id && (
      <link rel="alternate" hreflang="x-default" href={new URL(alternates.id, SITE.url).href} />
    )}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#983c09" />
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={displayFontUrl} as="font" type="font/woff2" crossorigin />
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col" data-cat={cat}>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:rounded focus:bg-paper-2 focus:px-3 focus:py-2"
    >
      {t('nav.skip')}
    </a>

    <header class="sticky top-0 z-30 border-b border-[#15120e] bg-[#983c09] text-white">
      <nav class={`relative mx-auto flex h-16 ${width} items-center justify-between gap-4 px-4`}>
        <a href={homeHref} aria-label={SITE.name}>
          <img
            src="/brand/toolland-logo-white.webp"
            alt=""
            width="158"
            height="48"
            class="h-11 w-auto"
          />
        </a>
        <!-- Menu utama (layar lebar): satu dropdown per kategori, isinya kartu tool.
             Buka dengan hover (mouse) atau klik/Enter; panel beranimasi lewat atribut data-open. -->
        <ul class="mr-auto ml-2 hidden items-center text-sm font-semibold lg:flex">
          {toolMenus.map((m) => (
            <li>
              <div class="nav-dd" data-nav-dd>
                <button
                  type="button"
                  class="nav-trigger"
                  aria-expanded="false"
                  aria-controls={`nav-p-${m.id}`}
                >
                  {m.name}
                  <IconChevronDown class="nav-chevron size-4" aria-hidden="true" />
                </button>
                <div id={`nav-p-${m.id}`} class={`nav-panel nav-mega ${m.panel}`} data-cat={m.id}>
                  <div class="nav-panel-head">
                    <p class="eyebrow tracking-wider uppercase">
                      {m.name} · {t('nav.toolCount', { n: m.items.length })}
                    </p>
                    <a href={m.href} class="nav-see-all">
                      {t('nav.seeAll')} <span aria-hidden="true">→</span>
                    </a>
                  </div>
                  <ul class={`grid gap-1 ${m.grid}`}>
                    {m.items.map((it) => (
                      <NavTile name={it.name} note={it.note} href={it.href} icon={it.icon} />
                    ))}
                  </ul>
                </div>
              </div>
            </li>
          ))}
          <li class="ml-1 border-l border-white/25 pl-1">
            <div class="nav-dd" data-nav-dd>
              <button
                type="button"
                class="nav-trigger"
                aria-expanded="false"
                aria-controls="nav-p-tpl"
              >
                {t('nav.templates')}
                <IconChevronDown class="nav-chevron size-4" aria-hidden="true" />
              </button>
              <div id="nav-p-tpl" class="nav-panel nav-mega w-[38rem]">
                <div class="nav-panel-head">
                  <p class="eyebrow tracking-wider uppercase">{t('nav.templatesHead')}</p>
                  <a href={tplHome} class="nav-see-all">
                    {t('nav.seeAll')} <span aria-hidden="true">→</span>
                  </a>
                </div>
                <ul class="grid grid-cols-2 gap-1">
                  {tplItems.map((it) => (
                    <NavTile
                      name={it.name}
                      note={it.note}
                      href={it.href}
                      icon={`tpl:${it.cat}`}
                      cat={it.cat}
                      soon={it.href ? undefined : t('nav.soon')}
                    />
                  ))}
                </ul>
              </div>
            </div>
          </li>
        </ul>
        <div class="hidden items-center gap-5 text-sm lg:flex">
          <a
            href={switchHref}
            hreflang={LOCALE_TAGS[otherLocale]}
            class="underline-offset-4 hover:underline"
          >
            {t('nav.language')}
          </a>
          <a
            href={donateHref}
            class="font-semibold underline decoration-2 underline-offset-4 hover:decoration-4"
          >
            {t('nav.donate')}
          </a>
        </div>

        <!-- Menu HP dan tablet: tombol garis tiga (berubah jadi X), isinya accordion per kategori. -->
        <div class="nav-dd lg:hidden" data-nav-dd data-mobile>
          <button
            type="button"
            class="nav-trigger nav-burger"
            aria-expanded="false"
            aria-controls="nav-p-mobile"
            aria-label={t('nav.menu')}
          >
            <IconMenu class="nav-burger-open size-6" aria-hidden="true" />
            <IconX class="nav-burger-close size-6" aria-hidden="true" />
          </button>
          <div
            id="nav-p-mobile"
            class="nav-panel nav-sheet inset-x-0 top-full mt-0 max-h-[calc(100dvh-4rem)] overflow-y-auto rounded-none border-x-0 p-2"
          >
            <p class="eyebrow px-3 pt-2 pb-1">{t('nav.tools')}</p>
            {toolMenus.map((m) => (
              <div class="nav-acc" data-cat={m.id}>
                <button
                  type="button"
                  class="nav-acc-head"
                  aria-expanded="false"
                  aria-controls={`nav-acc-${m.id}`}
                  data-acc
                >
                  <span class="nav-tile-icon size-8">
                    <ToolIcon name={`cat:${m.id}`} class="size-4" />
                  </span>
                  <span class="flex-1 text-left">
                    <span class="block font-semibold">{m.name}</span>
                    <span class="block text-xs text-ink-3">{m.note}</span>
                  </span>
                  <span class="eyebrow">{m.items.length}</span>
                  <IconChevronDown class="nav-chevron size-4 text-ink-3" aria-hidden="true" />
                </button>
                <div id={`nav-acc-${m.id}`} class="nav-acc-body" inert>
                  <div class="min-h-0 overflow-hidden">
                    <ul class="grid gap-1 pb-2 sm:grid-cols-2">
                      {m.items.map((it) => (
                        <NavTile name={it.name} note={it.note} href={it.href} icon={it.icon} />
                      ))}
                    </ul>
                  </div>
                </div>
              </div>
            ))}
            <p class="eyebrow mt-3 border-t border-rule px-3 pt-4 pb-1">{t('nav.templates')}</p>
            <ul class="grid gap-1 sm:grid-cols-2">
              {tplItems.map((it) => (
                <NavTile
                  name={it.name}
                  note={it.note}
                  href={it.href}
                  icon={`tpl:${it.cat}`}
                  cat={it.cat}
                  soon={it.href ? undefined : t('nav.soon')}
                />
              ))}
            </ul>
            <div class="mt-2 flex items-center justify-between border-t border-rule px-3 pt-4 pb-2 text-sm">
              <a
                href={switchHref}
                hreflang={LOCALE_TAGS[otherLocale]}
                class="underline underline-offset-4"
              >
                {t('nav.language')}
              </a>
              <a href={donateHref} class="font-semibold underline decoration-2 underline-offset-4">
                {t('nav.donate')}
              </a>
            </div>
          </div>
        </div>
      </nav>
    </header>
    <script>
      // Dropdown navbar: hanya satu yang terbuka. Dengan mouse terbuka saat kursor diarahkan ke
      // tombolnya (dengan jeda kecil agar tidak berkedip), juga bisa diklik atau dibuka dengan
      // keyboard. Tutup saat klik di luar, Esc, atau link diklik.
      const menus = [...document.querySelectorAll<HTMLElement>('[data-nav-dd]')];
      const trigger = (d: HTMLElement) => d.querySelector<HTMLButtonElement>(':scope > button')!;
      const panel = (d: HTMLElement) => d.querySelector<HTMLElement>(':scope > .nav-panel')!;
      const isOpen = (d: HTMLElement) => d.hasAttribute('data-open');
      let openedAt = 0;

      // Panel lebar dimulai di bawah tombolnya, tapi digeser ke kiri bila melewati tepi navbar.
      function place(d: HTMLElement) {
        const p = panel(d);
        const nav = d.closest('nav');
        if (!p.classList.contains('nav-mega') || !nav) return;
        const box = nav.getBoundingClientRect();
        const btn = trigger(d).getBoundingClientRect();
        const max = box.width - p.offsetWidth - 16;
        p.style.left = `${Math.max(16, Math.min(btn.left - box.left - 8, max))}px`;
      }

      function close(d: HTMLElement, instant = false) {
        if (!isOpen(d)) return;
        const p = panel(d);
        // Saat pindah ke dropdown lain, panel lama hilang langsung agar tidak bertumpuk.
        if (instant) p.classList.add('nav-instant');
        d.removeAttribute('data-open');
        trigger(d).setAttribute('aria-expanded', 'false');
        if (instant) requestAnimationFrame(() => p.classList.remove('nav-instant'));
      }

      function open(d: HTMLElement) {
        if (isOpen(d)) return;
        const switching = menus.some(isOpen);
        for (const other of menus) if (other !== d) close(other, true);
        place(d);
        const p = panel(d);
        if (switching) p.classList.add('nav-quick');
        else p.classList.remove('nav-quick');
        d.setAttribute('data-open', '');
        trigger(d).setAttribute('aria-expanded', 'true');
        openedAt = performance.now();
      }

      for (const d of menus) {
        const btn = trigger(d);
        btn.addEventListener('click', () => {
          // Klik tepat setelah hover membuka menu tidak langsung menutupnya lagi.
          if (isOpen(d) && performance.now() - openedAt < 400) return;
          if (isOpen(d)) close(d);
          else open(d);
        });
        for (const a of panel(d).querySelectorAll('a')) a.addEventListener('click', () => close(d));
        if (d.hasAttribute('data-mobile')) continue;
        let timer = 0;
        d.addEventListener('pointerenter', (e) => {
          if (e.pointerType !== 'mouse') return;
          clearTimeout(timer);
          // Pindah dari menu lain yang sedang terbuka: langsung, tanpa jeda.
          timer = window.setTimeout(() => open(d), menus.some(isOpen) ? 0 : 90);
        });
        d.addEventListener('pointerleave', (e) => {
          if (e.pointerType !== 'mouse') return;
          clearTimeout(timer);
          timer = window.setTimeout(() => close(d), 180);
        });
      }

      // Accordion di menu HP: tinggi beranimasi lewat CSS grid; isi yang tertutup dibuat inert
      // agar tidak bisa difokus dengan Tab.
      for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-acc]')) {
        const body = document.getElementById(btn.getAttribute('aria-controls')!)!;
        btn.addEventListener('click', () => {
          const expand = btn.getAttribute('aria-expanded') !== 'true';
          btn.setAttribute('aria-expanded', String(expand));
          body.inert = !expand;
        });
      }

      document.addEventListener('click', (e) => {
        for (const d of menus) if (isOpen(d) && !d.contains(e.target as Node)) close(d);
      });
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        const d = menus.find(isOpen);
        if (d) {
          close(d);
          trigger(d).focus();
        }
      });
    </script>

    <main id="main" class={`mx-auto w-full ${width} flex-1 px-4 pt-8 pb-16 sm:pt-12`}>
      <slot />
    </main>

    <footer class="border-t border-ink text-sm">
      <div
        class={`mx-auto grid ${width} gap-8 px-4 py-10 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1fr]`}
      >
        <div class="space-y-3">
          <a href={homeHref} class="inline-block" aria-label={SITE.name}>
            <picture>
              <source
                srcset="/brand/toolland-logo-white.webp"
                media="(prefers-color-scheme: dark)"
              />
              <img
                src="/brand/toolland-logo-orig.webp"
                alt=""
                width="158"
                height="48"
                class="h-10 w-auto"
              />
            </picture>
          </a>
          <p class="max-w-xs text-ink-2">{t('footer.tagline')}</p>
        </div>
        <nav aria-label={t('footer.tools')}>
          <p class="eyebrow mb-3">{t('footer.tools')}</p>
          <ul class="space-y-1.5">
            {CATEGORY_IDS.map((id) => (
              <li>
                <a href={`${homeHref}#${id}`} class="text-ink-2 hover:text-ink">
                  {CATEGORY_NAMES[id][locale]}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <nav aria-label={t('footer.templates')}>
          <p class="eyebrow mb-3">{t('footer.templates')}</p>
          <ul class="space-y-1.5">
            {tplCats.map((c) => (
              <li>
                <a href={`${tplHome}#${c.id}`} class="text-ink-2 hover:text-ink">
                  {c.name}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <nav aria-label={t('footer.about')}>
          <p class="eyebrow mb-3">{t('footer.about')}</p>
          <ul class="space-y-1.5">
            <li>
              <a href={privacyHref} class="text-ink-2 hover:text-ink">
                {t('footer.privacyPolicy')}
              </a>
            </li>
            <li>
              <a href={donateHref} class="text-ink-2 hover:text-ink">
                {t('nav.donate')}
              </a>
            </li>
            <li>
              <a href={SITE.repo} class="text-ink-2 hover:text-ink">
                GitHub
              </a>
            </li>
          </ul>
        </nav>
      </div>
      <div class={`mx-auto ${width} border-t border-rule px-4 py-4`}>
        <p class="eyebrow">{t('footer.colophon')}</p>
      </div>
    </footer>
  </body>
</html>
