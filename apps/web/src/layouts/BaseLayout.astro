---
import displayFontUrl from '@fontsource/fraunces/files/fraunces-latin-600-normal.woff2?url';
import fontUrl from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';
import Logo from '../components/ui/Logo.astro';
import { getLocale, pagePath, useTranslations, type Locale } from '../i18n';
import { CATEGORY_IDS, CATEGORY_NAMES, type CategoryId } from '../lib/categories';
import { LOCALE_TAGS } from '../lib/format';
import { SITE } from '../lib/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Path halaman yang sama di tiap bahasa, untuk hreflang dan tombol ganti bahasa. */
  alternates?: Partial<Record<Locale, string>>;
  noindex?: boolean;
  /** Kategori halaman: menentukan warna aksen (terakota, nila, kunyit, daun, secang). */
  cat?: CategoryId;
  /** Lebar konten: lebar untuk beranda, sedang untuk halaman tool dan teks. */
  wide?: boolean;
}

const { title, description, alternates = {}, noindex = false, cat, wide = false } = Astro.props;
const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const canonical = new URL(pagePath(Astro.url), SITE.url).href;
const otherLocale: Locale = locale === 'id' ? 'en' : 'id';
const switchHref = alternates[otherLocale] ?? (otherLocale === 'en' ? '/en' : '/');
const homeHref = locale === 'en' ? '/en' : '/';
const width = wide ? 'max-w-6xl' : 'max-w-5xl';
const donateHref = locale === 'en' ? '/en/support' : '/dukung';
const privacyHref = locale === 'en' ? '/en/privacy' : '/kebijakan-privasi';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {Object.entries(alternates).map(([lang, path]) => (
      <link
        rel="alternate"
        hreflang={LOCALE_TAGS[lang as Locale]}
        href={new URL(path, SITE.url).href}
      />
    ))}
    {alternates.id && (
      <link rel="alternate" hreflang="x-default" href={new URL(alternates.id, SITE.url).href} />
    )}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#f3eee4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#15120e" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={displayFontUrl} as="font" type="font/woff2" crossorigin />
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col" data-cat={cat}>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:rounded focus:bg-paper-2 focus:px-3 focus:py-2"
    >
      {t('nav.skip')}
    </a>

    <header class="border-b border-ink">
      <nav class={`mx-auto flex h-16 ${width} items-center justify-between gap-4 px-4`}>
        <a href={homeHref} class="flex items-center gap-2.5" aria-label={SITE.name}>
          <Logo />
          <span class="font-display text-[1.45rem] leading-none tracking-tight">toolland</span>
        </a>
        <div class="flex items-center gap-5 text-sm">
          <a
            href={switchHref}
            hreflang={LOCALE_TAGS[otherLocale]}
            class="text-ink-3 underline-offset-4 hover:text-ink hover:underline"
          >
            {t('nav.language')}
          </a>
          <a
            href={donateHref}
            class="font-semibold text-ink underline decoration-terakota decoration-2 underline-offset-4 hover:text-terakota"
          >
            {t('nav.donate')}
          </a>
        </div>
      </nav>
    </header>

    <main id="main" class={`mx-auto w-full ${width} flex-1 px-4 pt-8 pb-16 sm:pt-12`}>
      <slot />
    </main>

    <footer class="border-t border-ink text-sm">
      <div class={`mx-auto grid ${width} gap-8 px-4 py-10 sm:grid-cols-[1.4fr_1fr_1fr]`}>
        <div class="space-y-3">
          <a href={homeHref} class="flex items-center gap-2.5" aria-label={SITE.name}>
            <Logo class="size-5" />
            <span class="font-display text-xl leading-none">toolland</span>
          </a>
          <p class="max-w-xs text-ink-2">{t('footer.tagline')}</p>
        </div>
        <nav aria-label={t('footer.tools')}>
          <p class="eyebrow mb-3">{t('footer.tools')}</p>
          <ul class="space-y-1.5">
            {CATEGORY_IDS.map((id) => (
              <li>
                <a href={`${homeHref}#${id}`} class="text-ink-2 hover:text-ink">
                  {CATEGORY_NAMES[id][locale]}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <nav aria-label={t('footer.about')}>
          <p class="eyebrow mb-3">{t('footer.about')}</p>
          <ul class="space-y-1.5">
            <li>
              <a href={privacyHref} class="text-ink-2 hover:text-ink">
                {t('footer.privacyPolicy')}
              </a>
            </li>
            <li>
              <a href={donateHref} class="text-ink-2 hover:text-ink">
                {t('nav.donate')}
              </a>
            </li>
            <li>
              <a href={SITE.repo} class="text-ink-2 hover:text-ink">
                GitHub
              </a>
            </li>
          </ul>
        </nav>
      </div>
      <div class={`mx-auto ${width} border-t border-rule px-4 py-4`}>
        <p class="eyebrow">{t('footer.colophon')}</p>
      </div>
    </footer>
  </body>
</html>
