---
import EncodeTools from '../../components/tools/EncodeTools.vue';
import ToolPage from '../../components/ui/ToolPage.astro';
import { messages, toolMessages } from '../../i18n';
---

<ToolPage slug="base64-encode-decode">
  <EncodeTools
    client:visible
    tabs={messages('id', 'encode')}
    base64={toolMessages('id', 'base64')}
    url={toolMessages('id', 'urlEncode')}
    image={messages('id', 'image')}
    imageText={toolMessages('id', 'base64img')}
    dropzone={messages('id', 'dropzone')}
  />
</ToolPage>
