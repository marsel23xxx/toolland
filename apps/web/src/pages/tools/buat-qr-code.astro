---
import QRCode from 'qrcode';
import QrGenerator from '../../components/tools/QrGenerator.vue';
import ToolPage from '../../components/ui/ToolPage.astro';
import { toolMessages } from '../../i18n';
import { QR_DEFAULTS, qrOptions } from '../../lib/qr';

// QR awal dibuat saat build sehingga sudah ada di HTML (LCP cepat).
const initial = await QRCode.toDataURL(QR_DEFAULTS.text, qrOptions(QR_DEFAULTS));
---

<ToolPage slug="buat-qr-code">
  <QrGenerator client:visible m={toolMessages('id', 'qr')} initial={initial} />
</ToolPage>
