---
import ImageConverter from '../../components/tools/ImageConverter.vue';
import ToolPage from '../../components/ui/ToolPage.astro';
import { messages } from '../../i18n';
import { imageToolProps } from '../../lib/image/props';
---

<ToolPage slug="png-ke-jpg">
  <ImageConverter
    client:visible
    {...imageToolProps('id')}
    t={messages('id', 'convert')}
    defaultFormat="jpeg"
  />
</ToolPage>
