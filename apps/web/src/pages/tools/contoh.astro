---
// Halaman contoh Fase 0 untuk gerbang "Lighthouse 95+ di halaman contoh". noindex.
import DemoTool from '../../components/tools/DemoTool.vue';
import ToolLayout from '../../components/ui/ToolLayout.astro';
import { dropzoneMessages } from '../../lib/dropzone-messages';
---

<ToolLayout
  title="Contoh Tool"
  description="Halaman contoh untuk menguji kerangka tool Toolland. File tidak diproses dan tidak dikirim ke mana pun."
  processing="browser"
  noindex
>
  <DemoTool client:visible messages={dropzoneMessages('id')} locale="id" />

  <ol slot="how-to" class="list-decimal space-y-1 pl-5">
    <li>Pilih, tarik, atau tempel file ke area di atas.</li>
    <li>Tunggu proses selesai.</li>
    <li>Unduh hasilnya.</li>
  </ol>

  <dl slot="faq" class="space-y-4">
    <div>
      <dt class="font-semibold">Apakah file saya dikirim ke server?</dt>
      <dd class="text-slate-600 dark:text-slate-400">
        Tidak. File diproses di perangkatmu dan tidak pernah disimpan.
      </dd>
    </div>
    <div>
      <dt class="font-semibold">Apakah gratis?</dt>
      <dd class="text-slate-600 dark:text-slate-400">
        Ya, tanpa login, tanpa watermark, tanpa hitung mundur.
      </dd>
    </div>
  </dl>

  <ul slot="related" class="list-disc pl-5">
    <li>
      <a class="underline" href="/">
        Semua tools
      </a>
    </li>
  </ul>
</ToolLayout>
