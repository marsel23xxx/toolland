---
import ServerFileTool from '../../../components/tools/server/ServerFileTool.vue';
import ToolPage from '../../../components/ui/ToolPage.astro';
import { messages } from '../../../i18n';
---

<ToolPage slug="word-to-pdf">
  <ServerFileTool
    client:visible
    m={messages('en', 'server')}
    t={messages('en', 'pdf')}
    files={messages('en', 'files')}
