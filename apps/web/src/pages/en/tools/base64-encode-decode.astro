---
import EncodeTools from '../../../components/tools/EncodeTools.vue';
import ToolPage from '../../../components/ui/ToolPage.astro';
import { messages, toolMessages } from '../../../i18n';
---

<ToolPage slug="base64-encode-decode">
  <EncodeTools
    client:visible
    tabs={messages('en', 'encode')}
    base64={toolMessages('en', 'base64')}
    url={toolMessages('en', 'urlEncode')}
    image={messages('en', 'image')}
    imageText={toolMessages('en', 'base64img')}
    dropzone={messages('en', 'dropzone')}
  />
</ToolPage>
