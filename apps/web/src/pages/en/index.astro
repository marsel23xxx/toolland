---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n';

const t = useTranslations('en');
const categories = ['Images', 'PDF', 'Text', 'Developer', 'Media'];
---

<BaseLayout
  title={`${t('site.name')}: ${t('site.tagline')}`}
  description={t('site.description')}
  alternates={{ id: '/', en: '/en' }}
>
  <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">{t('site.tagline')}</h1>
  <p class="mt-3 max-w-2xl text-slate-600 dark:text-slate-400">{t('site.description')}</p>

  <ul class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {categories.map((name) => (
      <li class="rounded-xl border border-slate-200 p-4 dark:border-slate-800">
        <h2 class="font-bold">{name}</h2>
        <p class="text-sm text-slate-600 dark:text-slate-400">Coming soon</p>
      </li>
    ))}
  </ul>
</BaseLayout>
