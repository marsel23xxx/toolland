---
import { getCollection } from 'astro:content';
import IconSearch from '~icons/lucide/search';
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations } from '../i18n';
import { CATEGORY_IDS, CATEGORY_NAMES, toolPath } from '../lib/categories';

const locale = 'id';
const t = useTranslations(locale);
const tools = (await getCollection('tools', (e) => e.id.startsWith(`${locale}/`))).sort((a, b) =>
  a.data.name.localeCompare(b.data.name, locale),
);
const groups = CATEGORY_IDS.map((id) => ({
  id,
  name: CATEGORY_NAMES[id][locale],
  tools: tools.filter((tool) => tool.data.category === id),
}));

// Teks pencarian: nama, ringkasan, dan kata kunci, huruf kecil tanpa aksen.
const searchText = (tool: (typeof tools)[number]) =>
  [tool.data.name, tool.data.title, tool.data.summary, ...tool.data.keywords]
    .join(' ')
    .normalize('NFD')
    .replace(/\p{M}/gu, '')
    .toLowerCase();
---

<BaseLayout
  title={`${t('site.name')}: ${t('site.tagline')}`}
  description={t('site.description')}
  alternates={{ id: '/', en: '/en' }}
>
  <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">{t('site.tagline')}</h1>
  <p class="mt-3 max-w-2xl text-slate-600 dark:text-slate-400">{t('site.description')}</p>

  <div class="relative mt-6 max-w-xl">
    <label for="tool-search" class="sr-only">
      {t('home.searchLabel')}
    </label>
    <IconSearch
      class="pointer-events-none absolute top-1/2 left-3 -translate-y-1/2 text-slate-500"
      aria-hidden="true"
    />
    <input
      id="tool-search"
      type="search"
      class="field pl-10"
      placeholder={t('home.search')}
      autocomplete="off"
    />
  </div>
  <p id="no-results" class="mt-6 text-slate-600 dark:text-slate-400" hidden>
    {t('home.noResults')}
  </p>

  {groups.map((group) => (
    <section class="mt-10" data-category>
      <h2 class="text-xl font-bold">{group.name}</h2>
      {group.tools.length === 0 ? (
        <p class="mt-2 text-sm text-slate-600 dark:text-slate-400" data-coming-soon>
          {t('home.comingSoon')}
        </p>
      ) : (
        <ul class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {group.tools.map((tool) => (
            <li data-search={searchText(tool)}>
              <a
                href={toolPath(locale, tool.id.split('/')[1])}
                class="card block h-full transition-colors hover:border-brand-500"
              >
                <span class="font-semibold">{tool.data.name}</span>
                <span class="mt-1 block text-sm text-slate-600 dark:text-slate-400">
                  {tool.data.summary}
                </span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </section>
  ))}
</BaseLayout>

<script>
  // Pencarian tools tanpa server: menyaring kartu yang sudah ada di HTML.
  const input = document.getElementById('tool-search') as HTMLInputElement;
  const empty = document.getElementById('no-results')!;
  const sections = [...document.querySelectorAll<HTMLElement>('[data-category]')];

  input.addEventListener('input', () => {
    const terms = input.value
      .normalize('NFD')
      .replace(/\p{M}/gu, '')
      .toLowerCase()
      .split(/\s+/)
      .filter(Boolean);
    let visible = 0;
    for (const section of sections) {
      const items = [...section.querySelectorAll<HTMLElement>('[data-search]')];
      let shown = 0;
      for (const item of items) {
        const match = terms.every((term) => item.dataset.search!.includes(term));
        item.hidden = !match;
        if (match) shown++;
      }
      section.hidden = terms.length > 0 && shown === 0;
      visible += shown;
    }
    empty.hidden = terms.length === 0 || visible > 0;
  });
</script>
