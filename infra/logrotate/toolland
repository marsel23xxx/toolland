# Rotasi log Nginx host Toolland: harian, disimpan paling lama 7 hari.
# Pasang di VPS:  sudo cp infra/logrotate/toolland /etc/logrotate.d/toolland
# Uji:            sudo logrotate --debug /etc/logrotate.d/toolland
/var/log/nginx/toolland.access.log
/var/log/nginx/toolland.error.log {
    daily
    rotate 7
    maxage 7
    missingok
    notifempty
    compress
    delaycompress
    sharedscripts
    postrotate
        [ -s /run/nginx.pid ] && kill -USR1 "$(cat /run/nginx.pid)"
    endscript
}
