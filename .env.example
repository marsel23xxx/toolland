# Salin ke .env lalu isi. Jangan pernah commit .env.

# Lokasi folder rilis frontend di VPS (berisi releases/ dan symlink current).
WEB_ROOT=/srv/toolland/web

# Image API dari GitHub Container Registry.
API_IMAGE=ghcr.io/marsel23xxx/toolland-api:latest

# Konfigurasi API (dibaca dari environment).
TOOLLAND_API_ADDR=0.0.0.0:8082
RUST_LOG=info
